{
  "name": "logitrack-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build --webpack",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:automation",
    "test:automation": "node --test automation/test/review.test.mjs",
    "format": "prettier --write src tests *.ts *.mjs *.json",
    "format:check": "prettier --check src tests *.ts *.mjs *.json"
  },
  "dependencies": {
    "axios": "1.21.0",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "next": "16.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "5.1.0"
  }
}
