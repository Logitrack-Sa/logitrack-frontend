NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080
INTERNAL_GATEWAY_URL=http://api-gateway:8080
# availability admite el contrato actual y adapta respuestas antiguas.
NEXT_PUBLIC_COURIER_STATUS_MODEL=availability
# El backend verifica rol, pertenencia y estado antes de cancelar.
NEXT_PUBLIC_CUSTOMER_CANCELLATION_ENABLED=true
